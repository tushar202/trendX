{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["trends"],
  "properties": {
    "trends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary", "so_what", "evidence"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "so_what": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "object",
            "required": ["source_counts", "trust_score", "conflicts"],
            "properties": {
              "source_counts": {"type": "object"},
              "trust_score": {"type": "number", "minimum": 0, "maximum": 1},
              "conflicts": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
